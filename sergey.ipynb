   "source": [
    "n = int(input())\n",
    "f_i = 1\n",
    "f_minus_i = 1\n",
    "i = 1\n",
    "print(f_i, f_minus_i, end=' ')\n",
    "while i <= n - 2:\n",
    "    f_plus_i = f_i + f_minus_i\n",
    "    print(f_plus_i, end=' ')\n",
    "    f_minus_i = f_i\n",
    "    f_i = f_plus_i\n",
    "    i += 1  \n",
    "    \n",
    "    "
   ]
